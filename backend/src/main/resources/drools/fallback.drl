package com.example.backend.ai.rules

import com.example.backend.ai.facts.MoveOption;
import com.example.backend.ai.facts.EnemyDecision;
import com.example.backend.ai.facts.Tactic;
import com.example.backend.ai.TacticType;

// L2 fallback tactic: if no other tactic was chosen, maximize damage
rule "ChooseFallbackTactic"
    salience 1
when
    not Tactic()
then
    insert(new Tactic(TacticType.MAXIMIZE_DAMAGE));
end

// L3 ultimate fallback: if no decision was produced, pick the MoveOption with the lowest cost
rule "EmitFallbackDecision"
    salience 1
when
    not EnemyDecision()
    $opt : MoveOption($minCost : costValue)
    not MoveOption(costValue < $minCost)
then
    insert(new EnemyDecision($opt.getMoveId(), 1,
            "Fallback: cheapest available move"));
end
