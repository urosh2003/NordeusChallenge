package com.example.backend.ai.rules

import com.example.backend.services.ai.facts.EnemyFact;
import com.example.backend.services.ai.facts.PlayerFact;
import com.example.backend.services.ai.facts.MoveOption;
import com.example.backend.services.ai.facts.ResourceStatus;
import com.example.backend.services.ai.facts.StatComparison;
import com.example.backend.services.ai.facts.PerceivedThreat;
import com.example.backend.services.ai.facts.CantFinishPlayer;
import com.example.backend.services.ai.ResourceStatusType;
import com.example.backend.services.ai.StatComparisonType;
import com.example.backend.services.ai.ThreatLevel;

// Entry point: fires when no single MoveOption can kill the player this turn.
// Mutually exclusive with EmitImmediateKillMove — exactly one path fires per turn.
// CantFinishPlayer is the trigger for all perception and tactic rules.
rule "ConfirmNoImmediateKill"
when
    $p : PlayerFact($hp : currentHp)
    not MoveOption(projectedValue >= $hp)
    not CantFinishPlayer()
then
    insert(new CantFinishPlayer());
end

// Universal L1 — Enemy health state (PerceivedThreat = how endangered the enemy is).
// Exactly one of these three fires per turn, covering the full HP range.
rule "EvaluateEnemyThreatCritical"
when
    CantFinishPlayer()
    EnemyFact(hpPercent < 0.25)
    not PerceivedThreat()
then
    insert(new PerceivedThreat(ThreatLevel.CRITICAL));
end

rule "EvaluateEnemyThreatHigh"
when
    CantFinishPlayer()
    EnemyFact(hpPercent >= 0.25, hpPercent < 0.50)
    not PerceivedThreat()
then
    insert(new PerceivedThreat(ThreatLevel.HIGH));
end

rule "EvaluateEnemyThreatLow"
when
    CantFinishPlayer()
    EnemyFact(hpPercent >= 0.50)
    not PerceivedThreat()
then
    insert(new PerceivedThreat(ThreatLevel.LOW));
end

// Universal L1 — Resource assessment
rule "EvaluateResourceStaminaStarved"
when
    CantFinishPlayer()
    EnemyFact($maxStam : maxStamina, maxStamina > 0,
              currentStamina < $maxStam * 0.20)
    not ResourceStatus(resourceName == "stamina")
then
    insert(new ResourceStatus(ResourceStatusType.STARVED, "stamina"));
end

rule "EvaluateResourceManaStarved"
when
    CantFinishPlayer()
    EnemyFact($maxMana : maxMana, maxMana > 0,
              currentMana < $maxMana * 0.20)
    not ResourceStatus(resourceName == "mana")
then
    insert(new ResourceStatus(ResourceStatusType.STARVED, "mana"));
end

// Universal L1 — Stat comparison
rule "DetectStatDisadvantage"
when
    CantFinishPlayer()
    $p : PlayerFact($pa : attack)
    $e : EnemyFact($ed : defense)
    eval($pa - $ed > 5)
    not StatComparison(type == StatComparisonType.PLAYER_PHYSICAL_DOMINATES)
then
    insert(new StatComparison(StatComparisonType.PLAYER_PHYSICAL_DOMINATES));
end

rule "DetectMagicThreat"
when
    CantFinishPlayer()
    PlayerFact(magic >= 8)
    not StatComparison(type == StatComparisonType.PLAYER_MAGIC_DOMINATES)
then
    insert(new StatComparison(StatComparisonType.PLAYER_MAGIC_DOMINATES));
end
