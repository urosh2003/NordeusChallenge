package com.example.backend.ai.rules

import com.example.backend.services.ai.facts.*;
import com.example.backend.services.ai.TacticType;
import com.example.backend.services.ai.MoveCategory;
import com.example.backend.services.ai.ThreatLevel;

// Fires directly from input facts when a lethal move exists — no derived facts needed.
// Mutually exclusive with ConfirmNoImmediateKill in level1-perception.drl.
rule "EmitImmediateKillMove"
when
    $p : PlayerFact($hp : currentHp)
    ?canKillPlayer($hp; )
    not EnemyDecision(priority >= 100)
    $best : MoveOption(projectedValue >= $hp, $val : projectedValue)
    not MoveOption(projectedValue >= $hp, projectedValue > $val)
then
    insert(new EnemyDecision($best.getMoveId(), 100,
            "Immediate lethal move available: " + $best.getMoveId()));
end

// All remaining L3 rules are triggered by Tactic inserted by L2.

// L3 — MAXIMIZE_DAMAGE: prefer vulnerable damage type if player has a debuff active
rule "EmitMaximizeDamagePhysicalVulnerable"
when
    Tactic(type == TacticType.MAXIMIZE_DAMAGE)
    not EnemyDecision(priority >= 10)
    ?isVulnerableTo("player", "physical"; )
    $best : MoveOption(moveCategory == MoveCategory.DAMAGE_PHYSICAL, $val : projectedValue)
    not MoveOption(moveCategory == MoveCategory.DAMAGE_PHYSICAL, projectedValue > $val)
then
    insert(new EnemyDecision($best.getMoveId(), 10,
            "Player vulnerable to physical; maximize: " + $best.getMoveId()));
end

rule "EmitMaximizeDamageMagicVulnerable"
when
    Tactic(type == TacticType.MAXIMIZE_DAMAGE)
    not EnemyDecision(priority >= 10)
    ?isVulnerableTo("player", "magical"; )
    $best : MoveOption(moveCategory == MoveCategory.DAMAGE_MAGIC, $val : projectedValue)
    not MoveOption(moveCategory == MoveCategory.DAMAGE_MAGIC, projectedValue > $val)
then
    insert(new EnemyDecision($best.getMoveId(), 10,
            "Player vulnerable to magic; maximize: " + $best.getMoveId()));
end

// L3 — MAXIMIZE_DAMAGE: no specific vulnerability; pick highest-value damage move
rule "EmitMaximizeDamageAny"
when
    Tactic(type == TacticType.MAXIMIZE_DAMAGE)
    not EnemyDecision(priority >= 9)
    $best : MoveOption(
        (moveCategory == MoveCategory.DAMAGE_PHYSICAL || moveCategory == MoveCategory.DAMAGE_MAGIC),
        $val : projectedValue
    )
    not MoveOption(
        (moveCategory == MoveCategory.DAMAGE_PHYSICAL || moveCategory == MoveCategory.DAMAGE_MAGIC),
        projectedValue > $val
    )
then
    insert(new EnemyDecision($best.getMoveId(), 9,
            "Maximize damage output: " + $best.getMoveId()));
end

// L3 — SELF_BUFF tactic
rule "EmitSelfBuffMove"
when
    Tactic(type == TacticType.SELF_BUFF)
    not EnemyDecision(priority >= 7)
    $opt : MoveOption(moveCategory == MoveCategory.SELF_BUFF)
then
    insert(new EnemyDecision($opt.getMoveId(), 7,
            "Self-buff tactic: " + $opt.getMoveId()));
end

// L3 — DEBUFF_PLAYER tactic
rule "EmitDebuffMove"
when
    Tactic(type == TacticType.DEBUFF_PLAYER)
    not EnemyDecision(priority >= 7)
    $opt : MoveOption(moveCategory == MoveCategory.ENEMY_DEBUFF)
then
    insert(new EnemyDecision($opt.getMoveId(), 7,
            "Debuff player tactic: " + $opt.getMoveId()));
end

// L3 — DRAIN tactic
rule "EmitDrainMove"
when
    Tactic(type == TacticType.DRAIN)
    not EnemyDecision(priority >= 7)
    $opt : MoveOption(moveCategory == MoveCategory.DRAIN)
then
    insert(new EnemyDecision($opt.getMoveId(), 7,
            "Drain tactic: " + $opt.getMoveId()));
end

// L3 — CONSERVATIVE tactic: pick the lowest-cost move
rule "EmitConservativeMove"
when
    Tactic(type == TacticType.CONSERVATIVE)
    not EnemyDecision(priority >= 6)
    $opt : MoveOption($minCost : costValue)
    not MoveOption(costValue < $minCost)
then
    insert(new EnemyDecision($opt.getMoveId(), 6,
            "Conservative (low-resource) tactic: " + $opt.getMoveId()));
end
