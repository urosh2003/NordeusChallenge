package com.example.backend.ai.rules

import com.example.backend.services.ai.facts.EnemyFact;
import com.example.backend.services.ai.facts.CombatEventFact;
import com.example.backend.services.ai.facts.BurstDamageAssessment;
import com.example.backend.services.ai.facts.CantFinishPlayer;
import com.example.backend.services.ai.Severity;

// Accumulate: sum player damage dealt to enemy over the last ~3 player turns.
// window:time(6ms) — turnTimestamp is in turn units (1ms per TURN_CHANGED), and
// player/enemy alternate, so 6 turn-units covers roughly the last 3 player turns
// regardless of whether each turn dealt damage.
rule "AssessBurstDamageRisk"
    salience 150
when
    CantFinishPlayer()
    $enemy : EnemyFact($maxHp : maxHp)
    not BurstDamageAssessment()
    $total : Number(intValue > 0) from accumulate(
        CombatEventFact(type == "DAMAGE_DEALT",
                        source == "player",
                        $amount : amount)
        over window:time( 6ms )
        from entry-point "combat-stream",
        sum($amount)
    )
    eval($total.intValue() > $maxHp * 0.35)
then
    insert(new BurstDamageAssessment($total.intValue(), Severity.HIGH));
end
