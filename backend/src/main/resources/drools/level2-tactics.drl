package com.example.backend.ai.rules

import com.example.backend.services.ai.facts.*;
import com.example.backend.services.ai.TacticType;
import com.example.backend.services.ai.MoveCategory;
import com.example.backend.services.ai.ThreatLevel;
import com.example.backend.services.ai.StatComparisonType;
import com.example.backend.services.ai.ResourceStatusType;
import com.example.backend.services.ai.Severity;

// High burst reaction: triggered by BurstDamageAssessment inserted by CEP rules.
rule "ChooseDrainOnHighBurst"
    salience 80
when
    BurstDamageAssessment(severity == Severity.HIGH)
    MoveOption(moveCategory == MoveCategory.DRAIN)
    not Tactic()
then
    insert(new Tactic(TacticType.DRAIN));
end

rule "ChooseDebuffOnHighBurst"
    salience 79
when
    BurstDamageAssessment(severity == Severity.HIGH)
    MoveOption(moveCategory == MoveCategory.ENEMY_DEBUFF)
    not Tactic()
then
    insert(new Tactic(TacticType.DEBUFF_PLAYER));
end

rule "ChooseSelfBuffOnHighBurst"
    salience 78
when
    BurstDamageAssessment(severity == Severity.HIGH)
    MoveOption(moveCategory == MoveCategory.SELF_BUFF)
    not Tactic()
then
    insert(new Tactic(TacticType.SELF_BUFF));
end

rule "ChooseConservativeOnHighBurst"
    salience 77
when
    BurstDamageAssessment(severity == Severity.HIGH)
    not Tactic()
then
    insert(new Tactic(TacticType.CONSERVATIVE));
end

// Triggered by PerceivedThreat(LOW): enemy is healthy, so it can afford to pursue an aggressive finish.
rule "ChooseFinishSoonTactic"
    salience 60
when
    PerceivedThreat(level == ThreatLevel.LOW)
    $p : PlayerFact($hp : currentHp)
    $e : EnemyFact($em : currentMana, $es : currentStamina)
    not Tactic()
    ?canKillPlayerInNTurns($hp, $em, $es, 3; )
then
    insert(new Tactic(TacticType.MAXIMIZE_DAMAGE));
end

// Triggered by StatComparison inserted by L1 perception rule DetectStatDisadvantage / DetectMagicThreat.
rule "ChooseDebuffPlayerTactic"
    salience 50
when
    StatComparison(type == StatComparisonType.PLAYER_PHYSICAL_DOMINATES ||
                   type == StatComparisonType.PLAYER_MAGIC_DOMINATES)
    MoveOption(moveCategory == MoveCategory.ENEMY_DEBUFF)
    not Tactic()
then
    insert(new Tactic(TacticType.DEBUFF_PLAYER));
end

// Triggered by ResourceStatus inserted by L1 perception rules.
// Blocked when a 3-turn kill path is available: don't conserve resources if we can finish the fight.
rule "ChooseConservativeTactic"
    salience 45
when
    ResourceStatus(type == ResourceStatusType.STARVED)
    $p : PlayerFact($hp : currentHp)
    $e : EnemyFact($em : currentMana, $es : currentStamina)
    not Tactic()
    not ?canKillPlayerInNTurns($hp, $em, $es, 3; )
then
    insert(new Tactic(TacticType.CONSERVATIVE));
end

// Triggered by PerceivedThreat (inserted by archetype-specific L1 template rules).
rule "ChooseDrainTactic"
    salience 40
when
    PerceivedThreat(level == ThreatLevel.CRITICAL || level == ThreatLevel.HIGH)
    MoveOption(moveCategory == MoveCategory.DRAIN)
    not Tactic()
then
    insert(new Tactic(TacticType.DRAIN));
end

// Triggered by PerceivedThreat(LOW or HIGH): enemy is not critically endangered,
// so spending a turn on a self-buff is a reasonable investment.
rule "ChooseSelfBuffTactic"
    salience 35
when
    PerceivedThreat(level != ThreatLevel.CRITICAL)
    MoveOption(moveCategory == MoveCategory.SELF_BUFF)
    not Tactic()
then
    insert(new Tactic(TacticType.SELF_BUFF));
end
